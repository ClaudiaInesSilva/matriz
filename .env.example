# Local development only.
# Spring Boot does not load this file automatically.
DB_URL=jdbc:postgresql://localhost:5432/matriz_db
DB_USERNAME=matriz_app
DB_PASSWORD=fictional-example-only

# Docker Compose only.
# Replace both passwords with local-only values before starting Compose.
MATRIZ_COMPOSE_ADMIN_PASSWORD=replace-with-a-local-only-admin-password
MATRIZ_COMPOSE_DB_PASSWORD=replace-with-a-local-only-app-password